const agentBadge = document.getElementById('agentBadge');
const missionTitle = document.getElementById('missionTitle');
const beginMissionBtn = document.getElementById('beginMission');
const returnLoginBtn = document.getElementById('returnLogin');

const agentName = localStorage.getItem('agentName') || 'MIRA';
agentBadge.textContent = `AGENT ${agentName.toUpperCase()}`;
missionTitle.textContent = `Welcome, ${agentName.toUpperCase()}.`;

beginMissionBtn.addEventListener('click', () => {
  alert(`Mission engaged for ${agentName.toUpperCase()}.`);
});

returnLoginBtn.addEventListener('click', () => {
  window.location.href = 'index.html';
});
